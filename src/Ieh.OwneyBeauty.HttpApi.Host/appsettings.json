{
  "App": {
    "SelfUrl": "https://localhost:44389",
    "AngularUrl": "http://localhost:4200",
    "CorsOrigins": "http://localhost:4200",
    "RedirectAllowedUrls": "http://localhost:4200",
    "DisablePII": true,
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=OwneyBeauty;User ID=postgres;Password=postgres;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44389",
    "RequireHttpsMetadata": true,
    "SwaggerClientId": "OwneyBeauty_Swagger",
    "CertificatePassPhrase": "",
    "CertificateBase64": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 14
  },
  "StringEncryption": {
    "DefaultPassPhrase": ""
  },
  "Redis": {
    "IsEnabled": false,
    "Configuration": ""
  },
  "BackgroundProcessing": {
    "IsEnabled": true
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Otp": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "OpenTelemetry": {
    "ServiceName": "owney-api",
    "Otlp": {
      "Endpoint": ""
    }
  }
}
